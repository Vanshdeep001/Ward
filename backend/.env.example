# Copy to backend/.env (gitignored) and fill in. Values already set in the environment win.

# ─── Search (RAG over your inventory) ──────────────────────────────
# Pinecone: https://app.pinecone.io → API Keys. The index is created on first use, with Pinecone's
# hosted embedding model, so nothing is embedded on this machine. Leave empty to use the local index.
WARD_PINECONE_API_KEY=
WARD_PINECONE_INDEX=ward-resources
WARD_PINECONE_CLOUD=aws
WARD_PINECONE_REGION=us-east-1
WARD_PINECONE_EMBED_MODEL=llama-text-embed-v2
# Empty turns reranking off (saves Pinecone quota).
WARD_PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# The model that writes answers. Any OpenAI-compatible API — examples:
#   OpenAI      https://api.openai.com/v1                                gpt-4o-mini
#   Groq        https://api.groq.com/openai/v1                           openai/gpt-oss-120b
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.0-flash
#   OpenRouter  https://openrouter.ai/api/v1                             (any model id)
# Leave the key empty and answers list the matching resources instead.
WARD_RAG_LLM_URL=https://api.openai.com/v1
WARD_RAG_LLM_KEY=
WARD_RAG_LLM_MODEL=gpt-4o-mini

# ─── The fine-tuned compiler (finetune/scripts/07_serve.py) ─────────
# templates: hand-written patterns only · hybrid: templates first, the model for what they can't read ·
# llm: the model writes every policy. Start the model server first: python finetune/scripts/07_serve.py
#
# ⚠ Known issue: WARD_COMPILER defaults to "templates" even when WARD_LLM_URL points at a running
#   Ollama instance. You must set it explicitly to "hybrid" or "llm" to activate the fine-tuned model.
#
# For Ollama (recommended for local use with the fine-tuned model):
#   WARD_COMPILER=hybrid
#   WARD_LLM_URL=http://127.0.0.1:11434/v1
#   WARD_LLM_MODEL=ward-compiler        # name given to `ollama create`
WARD_COMPILER=templates
WARD_LLM_URL=http://127.0.0.1:8001/v1
WARD_LLM_MODEL=ward-compiler
WARD_LLM_TIMEOUT=180

# ─── Email alerts (SMTP) ────────────────────────────────────────────
# Gmail: turn on 2-Step Verification, create an App Password at https://myaccount.google.com/apppasswords
# and paste it below (16 letters, no spaces). WARD_ALERT_EMAILS empty = every administrator gets alerts.
# Test with: python -m app.admin test-email
WARD_SMTP_HOST=
WARD_SMTP_PORT=587
WARD_SMTP_USERNAME=
WARD_SMTP_PASSWORD=
WARD_SMTP_FROM=
WARD_ALERT_EMAILS=
