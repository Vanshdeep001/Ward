# Copy to backend/.env (gitignored) and fill in. Values already set in the environment win.

# ─── Search (RAG over your inventory) ──────────────────────────────
# Pinecone: https://app.pinecone.io → API Keys. The index is created on first use, with Pinecone's
# hosted embedding model, so nothing is embedded on this machine. Leave empty to use the local index.
WARD_PINECONE_API_KEY=
WARD_PINECONE_INDEX=ward-resources
WARD_PINECONE_CLOUD=aws
WARD_PINECONE_REGION=us-east-1
WARD_PINECONE_EMBED_MODEL=llama-text-embed-v2
# Empty turns reranking off (saves Pinecone quota).
WARD_PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# The model that writes answers. Any OpenAI-compatible API — examples:
#   OpenAI      https://api.openai.com/v1                                gpt-4o-mini
#   Groq        https://api.groq.com/openai/v1                           openai/gpt-oss-120b
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.0-flash
#   OpenRouter  https://openrouter.ai/api/v1                             (any model id)
# Leave the key empty and answers list the matching resources instead.
WARD_RAG_LLM_URL=https://api.openai.com/v1
WARD_RAG_LLM_KEY=
WARD_RAG_LLM_MODEL=gpt-4o-mini
